# Copy to terraform.tfvars and fill in real values.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# THIS FILE IS FOR NON-SECRET INPUTS ONLY.
#
# The two secrets — `hcloud_token` and `tailscale_authkey` — are deliberately
# NOT listed below. They are declared in variables.tf with no default, so
# Terraform prompts for them on every `plan` and `apply`:
#
#   var.hcloud_token
#     Hetzner Cloud API token ...
#     Enter a value:
#
# Paste at the prompt (input is not echoed for `sensitive` variables). Nothing
# is written to disk, so there is no file to accidentally commit.
#
# DO NOT "helpfully" add them to terraform.tfvars. An earlier version of this
# example carried a realistic `tailscale_authkey = "tskey-auth-..."` line, and
# a real key duly ended up in a tracked `tfplan` on a public repo for two
# weeks. A saved plan is a ZIP of every resolved input variable, so gitleaks
# scans it clean — see the path-based guard in .github/workflows/secret-scan.yml.
#
# Terraform state (*.tfstate) also holds these values in plaintext and is
# gitignored for the same reason. terraform.tfvars is gitignored too, which is
# a backstop, not a licence to put secrets in it.

# Your SSH public key, e.g. the contents of ~/.ssh/id_ed25519.pub.
# Public half only — safe to keep here.
ssh_public_key = "ssh-ed25519 AAAA...your-key... you@example.com"

# Optional overrides (defaults shown; see variables.tf for the caveats).
# server_type      = "cx22" # US locations may require cpx21 instead
# location         = "ash"  # fsn1 | nbg1 | hel1 | ash | hil | sin
# timezone         = "America/New_York"
# data_volume_size = 10
