# secrets.env.example — every secret this setup uses, NAMES ONLY.
#
# Brain (VPS): copy to /data/secrets.env and `chmod 600 /data/secrets.env`.
#   /data is the LUKS-encrypted volume, so the file is unreadable at rest and
#   simply absent until luks-unlock.sh runs after a reboot. systemd loads it
#   via EnvironmentFile=/data/secrets.env (see scripts/vps/systemd/).
# Mac: do NOT use an env file — store the same values in the Keychain via
#   scripts/mac/keychain-secrets.sh instead.
#
# This repo is public: never commit a filled-in copy, and remember NTFY_TOPIC
# and tailnet hostnames count as secrets too.

# OpenCode Zen API key (console via https://opencode.ai/docs/zen) — auth for the zen-openai and zen-anthropic providers
OPENCODE_ZEN_API_KEY=

# Together AI API key (https://api.together.ai) — sensitive tier + automation fallback provider
TOGETHER_API_KEY=

# Shared secret for `goose serve` client auth; generate: openssl rand -hex 32
GOOSE_SERVER__SECRET_KEY=

# ntfy.sh topic — the FAILURE-ALERT transport (run-recipe.sh -> notify.sh); recipes email their own results via Gmail, not through this. The topic name IS a password (anyone who knows it can read and send); generate: openssl rand -hex 12
NTFY_TOPIC=

# Recommended, NOT a secret: your own email address. When set, notify.sh has ntfy.sh forward each failure alert to it via the email gateway (free tier: ~5 emails/day — fine for rare alerts)
NTFY_EMAIL=

# ntfy topic for the AGENT channel — the phone buzzes when a code-agent turn
# ends or an agent is parked waiting for permission (code-agent-manager, NOT
# notify.sh). A SECOND topic on purpose, never NTFY_TOPIC: this is the one you
# subscribe a phone to, which turns the topic name from a read-only leak into a
# write channel onto your lock screen, so the two must be burnable
# independently. Payloads are content-free by construction — a kind, an opaque
# handle and a count (docs/privacy.md). Leave empty and the feature is simply
# off. Generate: openssl rand -hex 12
NTFY_AGENT_TOPIC=

# Telegram bot token from @BotFather — powers the phone's agentic surface
# (goose gateway on the brain, docs/setup/40-phone-setup.md §1a). A secret.
TELEGRAM_BOT_TOKEN=

# Tavily search API key (optional — only if the tavily extension is enabled in config.yaml)
TAVILY_API_KEY=

# --- code agents (docs/code-agents.md; both empty = feature stays disabled) ---
# Auth for the code plane: the manager gateway AND every per-chat opencode
# server behind it (HTTP Basic, any username); generate: openssl rand -hex 32
OPENCODE_SERVER_PASSWORD=

# Fine-grained GitHub PAT for code agents: scope it to the repos in
# /data/code-agents/repos.json ONLY, permissions Contents + Pull requests
# (read/write). The agent holds this inside its chat container (as GH_TOKEN)
# to clone, push, and open PRs itself — pushes are permission-gated in the
# app. Rotation: docs/security.md.
GITHUB_CODE_AGENT_PAT=

# Google OAuth client for workspace-mcp (own GCP app, published "In production" — docs/setup/30-google-oauth.md)
GOOGLE_OAUTH_CLIENT_ID=
# Your PRIMARY Gmail address — workspace-mcp's default account, and the only
# account recipes ever SEND the self-addressed delivery email from (not a
# secret, but personalization lives here, never in the recipes).
USER_GOOGLE_EMAIL=

# OPTIONAL multi-account roster (docs/setup/30-google-oauth.md §8): ALL the
# Google accounts the brain manages, comma-separated, FIRST entry = the
# primary (must equal USER_GOOGLE_EMAIL). Leave empty for a single account.
# Read by this repo's wiring (register-schedules.sh bakes it into the
# scheduled sweep recipes, run-recipe.sh passes it per run, check-mcp.sh
# verifies each account) — workspace-mcp itself never reads it. Each listed
# account needs its own one-time OAuth consent (same OAuth app).
USER_GOOGLE_EMAILS=

GOOGLE_OAUTH_CLIENT_SECRET=
