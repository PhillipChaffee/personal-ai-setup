# secrets.env.example — every secret this setup uses, NAMES ONLY.
#
# Brain (VPS): copy to /data/secrets.env and `chmod 600 /data/secrets.env`.
#   /data is the LUKS-encrypted volume, so the file is unreadable at rest and
#   simply absent until luks-unlock.sh runs after a reboot. systemd loads it
#   via EnvironmentFile=/data/secrets.env (see scripts/vps/systemd/).
#   The herdr plane gets its own pick-aware COPY of exactly the rows the
#   picked agents need — /data/herdr/secrets.env, written by unit_herdr() and
#   never hand-edited.
# Mac: do NOT use an env file — store the same values in the Keychain via
#   scripts/mac/keychain-secrets.sh instead.
#
# HAND-WRITTEN, AND DELIBERATELY NOT GENERATED. #39 made the Mac's roster a
# projection of config/units/*.yaml; this file stayed a file, because it is the
# only cross-file check `store: vps` has. Generating it from the same manifests
# the check reads would compare a function with itself and could never fail --
# and the prose below (which names, what the free tier costs) has no manifest
# field to live in. To see which of these names a
# given brain actually needs:
#
#     pai secrets --host vps                     # the default selection
#     pai secrets --host vps --units herdr       # the coding-agent plane's names
#
# This repo is public: never commit a filled-in copy, and remember tailnet
# hostnames count as secrets too.

# OpenCode Zen API key (console via https://opencode.ai/docs/zen) — auth for the zen-openai and zen-anthropic providers; also the Codex/Claude-Code pick's Zen-billing key
OPENCODE_ZEN_API_KEY=

# Together AI API key (https://api.together.ai) — sensitive tier + default hub provider; the credential OpenCode/Pi/Grok Build panes bill through
TOGETHER_API_KEY=

# Shared secret for `goose serve` client auth; generate: openssl rand -hex 32
# Stays goose-scoped: NEVER copied into the herdr plane's environment.
GOOSE_SERVER__SECRET_KEY=

# Tavily search API key (optional — only if the tavily extension is enabled in config.yaml)
TAVILY_API_KEY=

# --- coding agents on the brain (docs/coding-agents.md; picked = copied, unpicked = never written) ---

# Anthropic API key — the Claude Code VENDOR credential, asked at pick time.
# Optional: a pick can bill through Zen instead (then the herdr env carries
# ANTHROPIC_AUTH_TOKEN + ANTHROPIC_BASE_URL derived from OPENCODE_ZEN_API_KEY).
# When both this and the Zen key are present, the vendor key wins.
ANTHROPIC_API_KEY=

# OpenAI API key — the Codex VENDOR credential, asked at pick time. Optional:
# a pick can bill through Zen instead (then config.toml names the Zen key).
# When both are present, the vendor key wins.
OPENAI_API_KEY=

# Fine-grained GitHub PAT for the coding agents: scope it to ONLY the repos
# the agents should reach, permissions Contents + Pull requests (read/write).
# The scope IS the allowlist — there is no repos.json any more. Agents clone
# and push in herdr panes with this credential. Rotation: docs/security.md.
GITHUB_CODE_AGENT_PAT=