# workspace-mcp.env.example — env vars for taylorwilsdon/google_workspace_mcp
# (the Gmail/Calendar extension started by config/goose/config.yaml).
#
# Copy to an UNTRACKED location and fill in — never commit a filled-in copy:
#   Brain: fold these lines into /data/secrets.env (chmod 600).
#   Mac:   store the two secrets in the Keychain via scripts/mac/keychain-secrets.sh.
# config/goose/config.yaml references the two OAuth names via the
# workspace-mcp extension's `env_keys`, so goose resolves them from its
# secret store / process environment at launch — the values never live in
# config.yaml.
#
# Where the values come from: docs/setup/30-google-oauth.md — your own GCP
# OAuth client, with the consent screen published "In production" (an app left
# in "Testing" expires every refresh token after 7 days).

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# The DEFAULT Google account: used whenever a tool call doesn't name one.
# It is a default, not a restriction — every workspace-mcp tool also takes a
# user_google_email argument per call, and stored consents are keyed per
# account email (side-by-side token files), so one server instance can act
# on several accounts (verified upstream as of 2026-08-21). This setup
# treats the default as the PRIMARY account: recipes deliver their single
# self-addressed email from it. Not a secret, but personal — keep filled-in
# copies out of git anyway.
USER_GOOGLE_EMAIL=you@example.com

# Multi-account roster: USER_GOOGLE_EMAILS (comma-separated, first = primary)
# belongs in /data/secrets.env (brain) or your shell env (Mac). It is read by
# this repo's recipes wiring and check-mcp.sh, NOT by workspace-mcp itself —
# see docs/setup/30-google-oauth.md §8 for adding accounts.

# Scope and tool surface: set on the COMMAND LINE in config/goose/config.yaml,
# not here. That entry runs
#   uvx workspace-mcp@1.25.0 --permissions gmail:send calendar:full tasks:manage --tool-tier core
# — `--permissions` picks the services and the OAuth scopes (levels are
# cumulative per service), `--tool-tier core` caps the tool count at 10 to keep
# per-request context small, and the version is pinned so neither can drift
# under an unattended `uvx`. Widen or narrow it there. Recipes carry their own,
# tighter `--permissions` (docs/setup/30-google-oauth.md §5).
#
# Do not try to steer the tool surface from this file. Verified at 1.25.0:
#   WORKSPACE_MCP_TOOLS, WORKSPACE_MCP_READ_ONLY, WORKSPACE_MCP_PERMISSIONS
#     — ignored (info-logged, not an error) whenever --permissions is on the
#       command line, which it always is here. Setting them looks like it
#       worked and does nothing.
#   WORKSPACE_MCP_TOOL_TIER
#     — NOT ignored. It is only skipped when --tool-tier is already on the
#       command line. config.yaml passes --tool-tier core, so it is inert
#       there; the RECIPES deliberately pass no tier, so this variable would
#       apply to them. Setting it to `core` in /data/secrets.env would
#       silently strip inbox-triage of its label and draft tools (both
#       `extended` tier) — goose does no env_clear, so every MCP child
#       inherits it. Leave it unset.

# Where the OAuth TOKEN files live: nothing in this file (and no env var)
# pins a credentials directory — workspace-mcp writes its tokens to its
# default state dir, ~/.google_workspace_mcp/ (documented upstream as of
# 2026-08-20). Verify after the first auth: if your version puts tokens
# elsewhere, adjust the paths in docs/setup/30-google-oauth.md accordingly.
# On the brain, deploy-vps.sh symlinks ~/.google_workspace_mcp ->
# /data/workspace-mcp so the tokens land on the LUKS-encrypted volume.
# Token files ARE access to your mailbox — never let them near a repo.
