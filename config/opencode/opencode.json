{
  "$schema": "https://opencode.ai/config.json",
  "model": "togetherai/zai-org/GLM-5.3",
  "small_model": "togetherai/zai-org/GLM-5.3-Flash",
  "provider": {
    "together": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Together AI",
      "options": {
        "baseURL": "https://api.together.xyz/v1",
        "apiKey": "{env:TOGETHER_API_KEY}"
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B (Together)"
        },
        "Qwen/Qwen3.5-397B-A17B": {
          "name": "Qwen3.5 397B A17B (Together)"
        }
      }
    }
  },
  "mcp": {
    "todoist-example": {
      "type": "remote",
      "url": "https://ai.todoist.net/mcp",
      "enabled": false
    }
  }
}
