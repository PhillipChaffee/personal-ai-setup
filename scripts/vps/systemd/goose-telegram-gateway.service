# The phone's agentic surface: goose's Telegram gateway on the brain.
# Answers only the paired Telegram account (pair once with
# `goose gateway pair telegram` — docs/setup/40-phone-setup.md §1a).
# deploy-vps.sh enables this unit only when TELEGRAM_BOT_TOKEN is present
# in /data/secrets.env.
[Unit]
Description=goose Telegram gateway (phone agentic access)
After=network-online.target goose-serve.service
RequiresMountsFor=/data

[Service]
User=agent
EnvironmentFile=/data/secrets.env
ExecStartPre=/usr/bin/mountpoint -q /data
ExecStart=/bin/bash -o pipefail -c '[ -n "$TELEGRAM_BOT_TOKEN" ] || { echo "goose-telegram-gateway: TELEGRAM_BOT_TOKEN not set in /data/secrets.env" >&2; exit 1; }; exec /home/agent/.local/bin/goose gateway start telegram --bot-token "$TELEGRAM_BOT_TOKEN"'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
